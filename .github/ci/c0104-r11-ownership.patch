+using Microsoft.EntityFrameworkCore;
+using Solqaryn.Domain.Entities;
+using Solqaryn.Infrastructure.Persistence;
+
+// Test visibility exists only inside the isolated lab checkout.
+[assembly: System.Runtime.CompilerServices.InternalsVisibleTo("Solqaryn.Tests")]
+
+namespace Solqaryn.Infrastructure.AutomationV5;
+
+// Internal ownership candidate only. The caller still must authenticate,
+// resolve current grant for the exact operation AND resource, and revalidate
+// after I/O. This is not IV5CaseFileTenantScopedSnapshotSource or an API grant.
+internal sealed class V5CaseFilePersistentOwnershipReader(AppDbContext db)
+{
+    internal sealed record Candidate(int EmpresaId, int Id, int? SucursalId,
+        string RecursoTipo, string RecursoId, long Version, bool Archivado);
+
+    internal async Task<Candidate?> ReadAsync(int tenantId, int caseId, int? trustedBranchId,
+        CancellationToken cancellationToken)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        if (tenantId <= 0 || caseId <= 0 || trustedBranchId is <= 0 ||
+            db.AuthorizedCommercialEmpresaId != tenantId)
+            return null;
+
+        var row = await (
+            from p in db.Set<V5CaseFileOwnership>().AsNoTracking()
+            join v in db.Set<V5CaseFileVersion>().AsNoTracking()
+                on new { p.EmpresaId, ExpedienteId = p.Id }
+                equals new { v.EmpresaId, v.ExpedienteId }
+            where p.EmpresaId == tenantId && p.Id == caseId
+                && db.Set<Empresa>().Any(e => e.Id == tenantId && e.Activa)
+                && (p.SucursalId == null ||
+                    (p.SucursalId == trustedBranchId && db.Set<Sucursal>().Any(s =>
+                        s.Id == p.SucursalId && s.EmpresaId == tenantId && s.Activa && !s.Eliminado)))
+            orderby v.Version descending
+            select new Candidate(p.EmpresaId, p.Id, p.SucursalId, p.RecursoTipo,
+                p.RecursoId, v.Version, p.Archivado)
+        ).FirstOrDefaultAsync(cancellationToken);
+
+        cancellationToken.ThrowIfCancellationRequested();
+        return db.AuthorizedCommercialEmpresaId == tenantId ? row : null;
+    }
+}
diff --git a/backend/tests/Solqaryn.Tests/C0104M0304OwnershipPhysicalAssertions.cs b/backend/tests/Solqaryn.Tests/C0104M0304OwnershipPhysicalAssertions.cs
