+using Microsoft.AspNetCore.Http;
+using Microsoft.EntityFrameworkCore;
+using MySql.Data.MySqlClient;
+using MySql.EntityFrameworkCore.Extensions;
+using Solqaryn.Application.Security;
+using Solqaryn.Domain.Entities;
+using Solqaryn.Infrastructure.AutomationV5;
+using Solqaryn.Infrastructure.Persistence;
+using Xunit;
+
+namespace Solqaryn.Tests;
+
+// Adopt only in the dedicated R11 isolated checkout after the DEV01 patch,
+// Oracle migration, and DEV06 physical assertions have been applied.
+// This test never bootstraps the current model or calls EnsureCreated.
+[Trait("Category", "Integration")]
+[Trait("Lab", "C0104CaseFileOwnershipMigration")]
+public sealed class C0104M0304OwnershipMigrationFixtureTests
+{
+    private const string Prefix = "c0104_casefile_";
+    private const string Previous = "20261117215700_V19WhatsAppE164LiteralPlus";
+
+    [Fact]
+    public async Task MigratedOracleSchemaEnforcesOwnershipAndTenantFilters()
+    {
+        // Separate explicit lab connection: never fall back to the app DSN.
+        var raw = Environment.GetEnvironmentVariable("SOLQARYN_CASEFILE_MIGRATION_LAB_CONNECTION")
+            ?? throw new InvalidOperationException("Dedicated disposable lab connection required.");
+        var cs = new MySqlConnectionStringBuilder(raw);
+        if (Environment.GetEnvironmentVariable("GITHUB_ACTIONS") != "true" ||
+            cs.Server != "127.0.0.1" || cs.Port != 3306 ||
+            !cs.Database.StartsWith(Prefix, StringComparison.Ordinal) ||
+            cs.Database.Length != Prefix.Length + 32 ||
+            !Guid.TryParseExact(cs.Database[Prefix.Length..], "N", out _))
+            throw new InvalidOperationException("Disposable GitHub MySQL only.");
+
+        var target = Environment.GetEnvironmentVariable("SOLQARYN_CASEFILE_MIGRATION_LAB_TARGET")
+            ?? throw new InvalidOperationException("Exact generated migration ID required.");
+        Assert.Matches("^[0-9]{14}_V44C0104CaseFileOwnership$", target);
+        var options = new DbContextOptionsBuilder<AppDbContext>()
+            .UseMySQL(cs.ConnectionString, x => x.MigrationsAssembly("Solqaryn.Infrastructure.Migrations"))
+            .Options;
+        int a, b, branchA, branchB, legacy, actor;
+        var suffix = cs.Database[Prefix.Length..];
+        await using (var db = new AppDbContext(options))
+        {
+            await db.Database.OpenConnectionAsync();
+            await using (var command = db.Database.GetDbConnection().CreateCommand())
+            {
+                command.CommandText = "SELECT VERSION(), DATABASE()";
+                await using var result = await command.ExecuteReaderAsync();
+                Assert.True(await result.ReadAsync());
+                Assert.StartsWith("8.4.", result.GetString(0));
+                Assert.Equal(cs.Database, result.GetString(1));
+            }
+            var applied = (await db.Database.GetAppliedMigrationsAsync()).ToArray();
+            Assert.True(applied.Length >= 2);
+            Assert.Equal(Previous, applied[^2]);
+            Assert.Equal(target, applied[^1]);
+            Assert.Empty(await db.Database.GetPendingMigrationsAsync());
+            Assert.Equal(0, await db.Set<V5CaseFileOwnership>().IgnoreQueryFilters().CountAsync());
+            Assert.Equal(0, await db.Set<V5CaseFileVersion>().IgnoreQueryFilters().CountAsync());
+
+            var companyA = new Empresa("CASEFILE CI A " + suffix);
+            var companyB = new Empresa("CASEFILE CI B " + suffix);
+            db.Set<Empresa>().AddRange(companyA, companyB);
+            await db.SaveChangesAsync();
+            (a, b) = (companyA.Id, companyB.Id);
+            Assert.True(a > 0 && b > 0 && a != b);
+            var role = new Rol { Nombre = "CASEFILE CI " + suffix,
+                NombreNormalizado = "CASEFILE_CI_" + suffix.ToUpperInvariant(), EsSistema = true, Activo = true };
+            db.Set<Rol>().Add(role);
+            await db.SaveChangesAsync();
+            var user = new Usuario { NombreUsuario = "cf-ci-" + suffix,
+                NombreCompleto = "Synthetic CI actor", PasswordHash = "not-a-runtime-credential",
+                RolId = role.Id, Activo = true };
+            db.Set<Usuario>().Add(user);
+            await db.SaveChangesAsync();
+            actor = user.Id;
+            Assert.True(actor > 0);
+
+            // Direct fixture SQL only after CI/schema guards. The legacy row is
+            // intentionally unattributed, not a grant or production backfill.
+            async Task<int> Branch(int? owner, string kind)
+            {
+                var code = kind + suffix;
+                var at = DateTime.UtcNow;
+                await db.Database.ExecuteSqlInterpolatedAsync($"""
+                    INSERT INTO Sucursales
+                    (EmpresaId, Codigo, Nombre, ZonaHoraria, Activa, Eliminado, FechaCreacion, FechaActualizacion)
+                    VALUES ({owner}, {code}, {kind}, {"America/Tegucigalpa"}, {true}, {false}, {at}, {at})
+                    """);
+                return await db.Set<Sucursal>().IgnoreQueryFilters().AsNoTracking()
+                    .Where(x => x.Codigo == code).Select(x => x.Id).SingleAsync();
+            }
+            branchA = await Branch(a, "A");
+            branchB = await Branch(b, "B");
+            legacy = await Branch(null, "L");
+            await C0104M0304OwnershipPhysicalAssertions.VerifyAsync(db, a, b, branchA, branchB, legacy, actor);
+        }
+
+        // Real EF/MySQL filters; the test-only server marker is NOT JWT/RBAC
+        // evidence and cannot be reused as a production actor source.
+        async Task VerifyTenant(int tenant, int foreign, int owners, int revisions, long lastVersion)
+        {
+            var http = new DefaultHttpContext();
+            http.Items[VerifiedCommercialTenant.AuthorizedEmpresaIdItemKey] = tenant;
+            await using var db = new AppDbContext(options,
+                tenantHttpContextAccessor: new HttpContextAccessor { HttpContext = http });
+            Assert.Equal(tenant, db.AuthorizedCommercialEmpresaId);
+            var visible = await db.Set<V5CaseFileOwnership>().AsNoTracking().ToArrayAsync();
+            Assert.Equal(owners, visible.Length);
+            Assert.All(visible, row => Assert.Equal(tenant, row.EmpresaId));
+            Assert.DoesNotContain(visible, row => row.EmpresaId == foreign);
+            var versions = await db.Set<V5CaseFileVersion>().AsNoTracking().ToArrayAsync();
+            Assert.Equal(revisions, versions.Length);
+            Assert.All(versions, row => Assert.Equal(tenant, row.EmpresaId));
+            Assert.Equal(lastVersion, versions.Where(x => x.ExpedienteId == 9001).Max(x => x.Version));
+            Assert.DoesNotContain(visible, row => row.Id == 9005); // Rolled back by helper.
+            Assert.DoesNotContain(versions, row => row.ExpedienteId == 9005);
+
+            // Exercise the actual internal persisted candidate reader, not just DbSet filters.
+            // The synthetic marker proves the ownership query only, never JWT/RBAC authority.
+            var ownBranch = tenant == a ? branchA : branchB;
+            var otherBranch = tenant == a ? branchB : branchA;
+            var reader = new V5CaseFilePersistentOwnershipReader(db);
+            var candidate = await reader.ReadAsync(tenant, 9001, ownBranch, default);
+            Assert.NotNull(candidate);
+            Assert.Equal(tenant, candidate!.EmpresaId);
+            Assert.Equal(9001, candidate.Id);
+            Assert.Equal<int?>(ownBranch, candidate.SucursalId);
+            Assert.Equal(lastVersion, candidate.Version);
+            Assert.Equal("FIXTURE", candidate.RecursoTipo);
+            Assert.False(candidate.Archivado);
+            Assert.Null(await reader.ReadAsync(foreign, 9001, otherBranch, default));
+            Assert.Null(await reader.ReadAsync(tenant, 9001, otherBranch, default));
+            Assert.Null(await reader.ReadAsync(tenant, 9001, null, default));
+            Assert.Null(await reader.ReadAsync(tenant, 9002, ownBranch, default));
+            Assert.Null(await reader.ReadAsync(tenant, 9005, ownBranch, default));
+            Assert.Null(await reader.ReadAsync(tenant, 0, ownBranch, default));
+            http.Items[VerifiedCommercialTenant.AuthorizedEmpresaIdItemKey] = foreign;
+            Assert.Null(await reader.ReadAsync(tenant, 9001, ownBranch, default));
+            http.Items[VerifiedCommercialTenant.AuthorizedEmpresaIdItemKey] = tenant;
+            using var cancelled = new CancellationTokenSource();
+            cancelled.Cancel();
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() =>
+                reader.ReadAsync(tenant, 9001, ownBranch, cancelled.Token));
+        }
+        await VerifyTenant(a, b, 2, 2, 2);
+        await VerifyTenant(b, a, 1, 1, 1);
+        await using (var noAuthority = new AppDbContext(options))
+        {
+            Assert.Null(noAuthority.AuthorizedCommercialEmpresaId);
+            Assert.Empty(await noAuthority.Set<V5CaseFileOwnership>().AsNoTracking().ToArrayAsync());
+            Assert.Empty(await noAuthority.Set<V5CaseFileVersion>().AsNoTracking().ToArrayAsync());
+            var reader = new V5CaseFilePersistentOwnershipReader(noAuthority);
+            Assert.Null(await reader.ReadAsync(a, 9001, branchA, default));
+        }
+        // Runner owns schema rollback/reapply and disposable DB cleanup.
+    }
+}
