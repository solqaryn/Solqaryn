+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+using Solqaryn.Domain.Entities;
+
+namespace Solqaryn.Infrastructure.Persistence.Configurations;
+
+public sealed class V5CaseFileOwnershipConfiguration : IEntityTypeConfiguration<V5CaseFileOwnership>
+{
+    public void Configure(EntityTypeBuilder<V5CaseFileOwnership> b)
+    {
+        b.ToTable("V5CaseFileOwnerships", t =>
+        {
+            t.HasCheckConstraint("CK_V5CaseFile_Owner", "EmpresaId > 0 AND Id > 0 AND (SucursalId IS NULL OR SucursalId > 0)");
+            t.HasCheckConstraint("CK_V5CaseFile_Resource", "LENGTH(TRIM(RecursoTipo)) > 0 AND LENGTH(TRIM(RecursoId)) > 0");
+        });
+        b.HasKey(x => new { x.EmpresaId, x.Id });
+        b.Property(x => x.Id).ValueGeneratedNever();
+        b.Property(x => x.RecursoTipo).HasMaxLength(64).IsRequired();
+        b.Property(x => x.RecursoId).HasMaxLength(128).IsRequired();
+        b.HasIndex(x => new { x.EmpresaId, x.RecursoTipo, x.RecursoId });
+        b.HasIndex(x => new { x.EmpresaId, x.SucursalId });
+        b.HasOne<Empresa>().WithMany().HasForeignKey(x => x.EmpresaId).OnDelete(DeleteBehavior.Restrict);
+        b.HasOne<Sucursal>().WithMany().HasForeignKey(x => x.SucursalId).OnDelete(DeleteBehavior.Restrict);
+        // Composite tenant/sucursal FK is appended in Oracle migration, as in
+        // 20261013231000_CommercialTenantRemainingScopedFks. Do not turn nullable
+        // legacy Sucursal.EmpresaId into an EF alternate key.
+    }
+}
+
+public sealed class V5CaseFileVersionConfiguration : IEntityTypeConfiguration<V5CaseFileVersion>
+{
+    public void Configure(EntityTypeBuilder<V5CaseFileVersion> b)
+    {
+        b.ToTable("V5CaseFileVersions", t =>
+        {
+            t.HasCheckConstraint("CK_V5CaseFileVersion_Ids", "EmpresaId > 0 AND ExpedienteId > 0 AND Version >= 0 AND ActorId > 0");
+            t.HasCheckConstraint("CK_V5CaseFileVersion_Hash", "LENGTH(ContentHash) = 64 AND LENGTH(TRIM(Motivo)) > 0");
+        });
+        b.HasKey(x => new { x.EmpresaId, x.ExpedienteId, x.Version });
+        b.Property(x => x.Version).ValueGeneratedNever();
+        b.Property(x => x.ContentHash).HasMaxLength(64).IsRequired();
+        b.Property(x => x.FechaUtc).HasPrecision(6);
+        b.Property(x => x.Motivo).HasMaxLength(512).IsRequired();
+        b.HasOne<V5CaseFileOwnership>().WithMany()
+            .HasForeignKey(x => new { x.EmpresaId, x.ExpedienteId })
+            .OnDelete(DeleteBehavior.Restrict);
+        b.HasOne<Usuario>().WithMany().HasForeignKey(x => x.ActorId)
+            .OnDelete(DeleteBehavior.Restrict);
+    }
+}
