+using Microsoft.EntityFrameworkCore;
+using MySql.Data.MySqlClient;
+using Solqaryn.Domain.Entities;
+using Solqaryn.Infrastructure.Persistence;
+using Xunit;
+
+namespace Solqaryn.Tests;
+
+// Adoption prerequisite: the proposed P01/P02 types, model configuration and
+// Oracle migration must exist. This helper is not a runtime authorization source.
+internal static class C0104M0304OwnershipPhysicalAssertions
+{
+    internal static async Task VerifyAsync(AppDbContext db, int a, int b,
+        int branchA, int branchB, int legacyBranch, int actor)
+    {
+        var cs = new MySqlConnectionStringBuilder(db.Database.GetDbConnection().ConnectionString);
+        if (Environment.GetEnvironmentVariable("GITHUB_ACTIONS") != "true" ||
+            (cs.Server != "127.0.0.1" && cs.Server != "localhost") ||
+            !cs.Database.StartsWith("c0104_casefile_", StringComparison.Ordinal) ||
+            cs.Database.Length != "c0104_casefile_".Length + 32 ||
+            !Guid.TryParseExact(cs.Database["c0104_casefile_".Length..], "N", out _))
+            throw new InvalidOperationException("Disposable GitHub MySQL only.");
+
+        Assert.NotEqual(a, b);
+        Assert.Equal(a, await db.Set<Sucursal>().IgnoreQueryFilters()
+            .Where(x => x.Id == branchA).Select(x => x.EmpresaId).SingleAsync());
+        Assert.Equal(b, await db.Set<Sucursal>().IgnoreQueryFilters()
+            .Where(x => x.Id == branchB).Select(x => x.EmpresaId).SingleAsync());
+        Assert.Null(await db.Set<Sucursal>().IgnoreQueryFilters()
+            .Where(x => x.Id == legacyBranch).Select(x => x.EmpresaId).SingleAsync());
+
+        var hash = new string('a', 64);
+        var at = new DateTime(2026, 11, 25, 0, 0, 0, DateTimeKind.Utc);
+        async Task P01(int tenant, int caseId, int? branch)
+        {
+            await db.Database.ExecuteSqlInterpolatedAsync($"""
+                INSERT INTO V5CaseFileOwnerships
+                (EmpresaId, Id, SucursalId, RecursoTipo, RecursoId, Archivado)
+                VALUES ({tenant}, {caseId}, {branch}, {"FIXTURE"}, {"ONLY-CI"}, {false})
+                """);
+        }
+        async Task P02(int tenant, int caseId, long version)
+        {
+            await db.Database.ExecuteSqlInterpolatedAsync($"""
+                INSERT INTO V5CaseFileVersions
+                (EmpresaId, ExpedienteId, Version, ContentHash, ActorId, FechaUtc, Motivo)
+                VALUES ({tenant}, {caseId}, {version}, {hash}, {actor}, {at}, {"CI fixture"})
+                """);
+        }
+        async Task Reject(int expectedNumber, Func<Task> action)
+        {
+            var failure = await Assert.ThrowsAsync<MySqlException>(action);
+            Assert.Equal(expectedNumber, failure.Number);
+        }
+        async Task<int> Owners(int tenant) =>
+            await db.Set<V5CaseFileOwnership>().IgnoreQueryFilters().AsNoTracking()
+                .CountAsync(x => x.EmpresaId == tenant);
+        async Task<int> Versions(int tenant) =>
+            await db.Set<V5CaseFileVersion>().IgnoreQueryFilters().AsNoTracking()
+                .CountAsync(x => x.EmpresaId == tenant);
+
+        await P01(a, 9001, branchA);
+        await P01(b, 9001, branchB); // Same local ID is legal across tenants.
+        await P01(a, 9002, null); // Optional verified branch.
+        await P02(a, 9001, 1);
+        await P02(b, 9001, 1);
+        await P02(a, 9001, 2); // Existing revisions survive.
+        await Reject(1452, () => P01(a, 9003, branchB));
+        await Reject(1452, () => P01(a, 9004, legacyBranch));
+        await Reject(1452, () => P02(b, 9002, 1));
+        await Reject(1062, () => P02(a, 9001, 1));
+        await Reject(1062, () => P01(a, 9001, branchA));
+        Assert.Equal(2, await Owners(a));
+        Assert.Equal(1, await Owners(b));
+        Assert.Equal(2, await Versions(a));
+        Assert.Equal(1, await Versions(b));
+
+        await using (var tx = await db.Database.BeginTransactionAsync())
+        {
+            await P01(a, 9005, branchA);
+            await P02(a, 9005, 1);
+            Assert.Equal(3, await Owners(a));
+            Assert.Equal(3, await Versions(a));
+            await tx.RollbackAsync();
+        }
+        Assert.Equal(2, await Owners(a));
+        Assert.Equal(2, await Versions(a));
+        Assert.Equal(1, await Owners(b));
+        Assert.Equal(1, await Versions(b));
+    }
+}
