+namespace Solqaryn.Domain.Entities;
+
+// P01: no resource ownership is inferred by this record. Only a future
+// authorized writer may create it after checking the underlying resource.
+public sealed class V5CaseFileOwnership
+{
+    private V5CaseFileOwnership() { }
+    public int EmpresaId { get; private set; }
+    public int Id { get; private set; }
+    public int? SucursalId { get; private set; }
+    public string RecursoTipo { get; private set; } = string.Empty;
+    public string RecursoId { get; private set; } = string.Empty;
+    public bool Archivado { get; private set; }
+
+    public V5CaseFileOwnership(int empresaId, int id, int? sucursalId,
+        string recursoTipo, string recursoId)
+    {
+        if (empresaId <= 0 || id <= 0 || sucursalId is <= 0)
+            throw new ArgumentOutOfRangeException(nameof(empresaId));
+        if (string.IsNullOrWhiteSpace(recursoTipo) || recursoTipo.Length > 64 ||
+            string.IsNullOrWhiteSpace(recursoId) || recursoId.Length > 128)
+            throw new ArgumentException("CASEFILE_RESOURCE_INVALID");
+        EmpresaId = empresaId; Id = id; SucursalId = sucursalId;
+        RecursoTipo = recursoTipo; RecursoId = recursoId;
+    }
+}
+
+// P02: append-only revision shape. A monotonic writer/transaction is not
+// implemented by this type; no business effect is exposed by this package.
+public sealed class V5CaseFileVersion
+{
+    private V5CaseFileVersion() { }
+    public int EmpresaId { get; private set; }
+    public int ExpedienteId { get; private set; }
+    public long Version { get; private set; }
+    public string ContentHash { get; private set; } = string.Empty;
+    public int ActorId { get; private set; }
+    public DateTime FechaUtc { get; private set; }
+    public string Motivo { get; private set; } = string.Empty;
+
+    public V5CaseFileVersion(int empresaId, int expedienteId, long version,
+        string contentHash, int actorId, DateTime fechaUtc, string motivo)
+    {
+        if (empresaId <= 0 || expedienteId <= 0 || version < 0 || actorId <= 0)
+            throw new ArgumentOutOfRangeException(nameof(empresaId));
+        if (contentHash is not { Length: 64 } || !contentHash.All(Uri.IsHexDigit) ||
+            fechaUtc.Kind != DateTimeKind.Utc || string.IsNullOrWhiteSpace(motivo) ||
+            motivo.Length > 512)
+            throw new ArgumentException("CASEFILE_REVISION_INVALID");
+        EmpresaId = empresaId; ExpedienteId = expedienteId; Version = version;
+        ContentHash = contentHash.ToLowerInvariant(); ActorId = actorId;
+        FechaUtc = fechaUtc; Motivo = motivo;
+    }
+}
