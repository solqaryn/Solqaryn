  "triggers": [
    {
      "name": "TR_QAC3_Galeria_BI",
      "table": "CategoriasGalerias",
      "action": "INSERT",
      "body": "IF NEW.CategoriaVerificadaId IS NULL OR NEW.CategoriaVerificadaId <> NEW.CategoriaId THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Verified tenant category required'; END IF;"
    },
    {
      "name": "TR_QAC3_ImpuestoDocumento_BI",
      "table": "HistorialAplicacionImpuestos",
      "action": "INSERT",
      "body": "IF NEW.EmpresaId IS NOT NULL AND NOT ((BINARY NEW.DocumentoTipo = BINARY 'Venta' AND EXISTS (SELECT 1 FROM Ventas v WHERE v.Id=NEW.DocumentoId AND v.EmpresaId=NEW.EmpresaId)) OR (BINARY NEW.DocumentoTipo = BINARY 'Compra' AND EXISTS (SELECT 1 FROM Compras c WHERE c.Id=NEW.DocumentoId AND c.EmpresaId=NEW.EmpresaId))) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Document tenant mismatch'; END IF;"
    },
    {
      "name": "TR_QAC3_Conteo_BI",
      "table": "ConteosInventario",
      "action": "INSERT",
      "body": "IF NEW.EmpresaId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Almacenes a JOIN Sucursales s ON s.Id=a.SucursalId WHERE a.Id=NEW.AlmacenId AND s.EmpresaId=NEW.EmpresaId) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Warehouse tenant mismatch'; END IF;"
    },
    {
      "name": "TR_QAC3_ConteoDetalle_BI",
