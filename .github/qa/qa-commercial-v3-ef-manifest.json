    },
    {
      "name": "TR_QAC3_ImpuestoDocumento_BU",
      "table": "HistorialAplicacionImpuestos",
      "action": "UPDATE",
      "body": "IF NEW.EmpresaId IS NOT NULL AND NOT ((BINARY NEW.DocumentoTipo = BINARY 'Venta' AND EXISTS (SELECT 1 FROM Ventas v WHERE v.Id=NEW.DocumentoId AND v.EmpresaId=NEW.EmpresaId)) OR (BINARY NEW.DocumentoTipo = BINARY 'Compra' AND EXISTS (SELECT 1 FROM Compras c WHERE c.Id=NEW.DocumentoId AND c.EmpresaId=NEW.EmpresaId))) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Document tenant mismatch'; END IF;"
    },
    {
      "name": "TR_QAC3_Conteo_BU",
      "table": "ConteosInventario",
      "action": "UPDATE",
      "body": "IF NEW.EmpresaId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Almacenes a JOIN Sucursales s ON s.Id=a.SucursalId WHERE a.Id=NEW.AlmacenId AND s.EmpresaId=NEW.EmpresaId) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Warehouse tenant mismatch'; END IF;"
    },
    {
      "name": "TR_QAC3_ConteoDetalle_BU",
      "table": "ConteoInventarioDetalles",
      "action": "UPDATE",
      "body": "IF NEW.EmpresaId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Almacenes a JOIN Sucursales s ON s.Id=a.SucursalId WHERE a.Id=NEW.AlmacenId AND s.EmpresaId=NEW.EmpresaId) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Warehouse tenant mismatch'; END IF;"
    },
    {
      "name": "TR_QAC3_Almacen_Conteo_BU",
      "table": "Almacenes",
      "action": "UPDATE",
      "body": "IF NOT (NEW.SucursalId <=> OLD.SucursalId) AND EXISTS (SELECT 1 FROM ConteosInventario c WHERE c.AlmacenId=OLD.Id AND c.EmpresaId IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Sucursales s WHERE s.Id=NEW.SucursalId AND s.EmpresaId=c.EmpresaId)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Warehouse move would invalidate count owner'; END IF;"
    },
    {
      "name": "TR_QAC3_Sucursal_Conteo_BU",
      "table": "Sucursales",
      "action": "UPDATE",
      "body": "IF NOT (NEW.EmpresaId <=> OLD.EmpresaId) AND EXISTS (SELECT 1 FROM ConteosInventario c JOIN Almacenes a ON a.Id=c.AlmacenId WHERE a.SucursalId=OLD.Id AND c.EmpresaId IS NOT NULL AND NOT (c.EmpresaId <=> NEW.EmpresaId)) THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Branch move would invalidate count owner'; END IF;"
