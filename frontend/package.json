    "test:e2e:storefront-fase6": "playwright test e2e/storefront-fase6.spec.ts --config=playwright.config.ts",
    "test:e2e:storefront-fase7": "playwright test e2e/storefront-fase7.spec.ts --config=playwright.config.ts",
    "test:responsive": "playwright test e2e/responsive-global.spec.ts --config=playwright.config.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
