    "test:e2e:storefront-fase12": "playwright test e2e/storefront-fase12.spec.ts --config=playwright.config.ts",
    "perf:bundle-baseline": "npm run build:stats && node scripts/performance-bundle-baseline.mjs && node scripts/analyze-angular-stats.mjs",
    "build:stats": "ng build --configuration production --stats-json"
  },
