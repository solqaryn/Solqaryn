{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/varistorehn",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=home"
    },
    {
      "source": "/varistorehn/productos",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=products"
    },
    {
      "source": "/varistorehn/ofertas",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=offers"
    },
    {
      "source": "/varistorehn/categorias",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=categories"
    },
    {
      "source": "/varistorehn/categoria/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=category&slug=:slug"
    },
    {
      "source": "/varistorehn/producto/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=product&slug=:slug"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "solqaryn-prod.vercel.app"
        }
      ],
      "destination": "https://solqaryn-api-prod.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "solqaryn.com"
        }
      ],
      "destination": "https://solqaryn-api-prod.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.solqaryn.com"
        }
      ],
      "destination": "https://solqaryn-api-prod.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://solqaryn-api-dev-fxx8.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*-[A-Za-z0-9]{8,}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
